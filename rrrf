-- 只处理 WHITELIST_SKILLS 中的技能
--------------------------------------------------
local function forceWhitelistSkillObtainable(skillFolder)
    if not skillFolder or not skillFolder:IsA("Folder") then
        return false
    end

    local changed = false

    --------------------------------------------------
    -- 处理 Attribute 形式的 Unobtainable
    --------------------------------------------------
    if skillFolder:GetAttribute("Unobtainable") ~= nil then
        pcall(function()
            skillFolder:SetAttribute(
                "Unobtainable",
                false
            )
        end)

        changed = true
    end

    --------------------------------------------------
    -- 查找子对象形式的 Unobtainable
    -- 忽略大小写
    --------------------------------------------------
    local unobtainableObject = nil

    for _, child in ipairs(skillFolder:GetChildren()) do
        if normalizeKey(child.Name)
            == normalizeKey("Unobtainable")
        then
            unobtainableObject = child
            break
        end
    end

    if unobtainableObject then
        if unobtainableObject:IsA("BoolValue") then
            unobtainableObject.Value = false
            changed = true

        elseif unobtainableObject:IsA("StringValue") then
            unobtainableObject.Value = "false"
            changed = true

        elseif unobtainableObject:IsA("NumberValue")
            or unobtainableObject:IsA("IntValue")
        then
            unobtainableObject.Value = 0
            changed = true
        end
    else
        --------------------------------------------------
        -- 如果完全没有 Unobtainable，则创建 BoolValue
        --------------------------------------------------
        local newValue = Instance.new("BoolValue")
        newValue.Name = "Unobtainable"
        newValue.Value = false
        newValue.Parent = skillFolder
        changed = true
    end

    return changed
end



