function buildAutoExecuteLoader()
    local loader = LOADER_TEMPLATE
    local replacements = {
        ["__VERSION__"] = quoteLua(AUTO_EXECUTE_VERSION),
        ["__URL__"] = quoteLua(AUTO_EXECUTE_URL),
        ["__FLAG__"] = quoteLua(AUTO_EXECUTE_FLAG_FILE),
        ["__FILE__"] = quoteLua(AUTO_EXECUTE_FILE)
    }

    for token, replacement in pairs(replacements) do
        loader = loader:gsub(token, function()
            return replacement
        end)
    end

    return loader
end

function ensureFolderPath(path)
    if type(makefolder) ~= "function" then
        return
    end

    local current = ""

    for part in path:gmatch("[^/]+") do
        current = current == "" and part or current .. "/" .. part

        pcall(function()
            if type(isfolder) ~= "function"
                or not isfolder(current)
            then
                makefolder(current)
            end
        end)
    end
end

function writeLoaderToAllPaths(loader)
    if type(writefile) ~= "function" then
        warn("[JJI AutoExecute] 当前执行器不支持 writefile")
        return false
    end

    local writtenCount = 0

    for _, path in ipairs(AUTO_EXECUTE_PATHS) do
        local directory = path:match("^(.*)/[^/]+$")

        if directory then
            ensureFolderPath(directory)
        end

        local written = pcall(function()
            writefile(path, loader)
        end)

        if written then
            writtenCount += 1
        end
    end

    if writtenCount == 0 then
        warn("[JJI AutoExecute] 所有 Autoexec 路径均写入失败")
        return false
    end

    print(
        "[JJI AutoExecute] Loader 已更新，成功路径:",
        writtenCount
    )

    return true
end

installAutoExecute = function()
    refreshToggleSettings()

    local loader = buildAutoExecuteLoader()

    -- 所有常见目录写入同一个 Loader。
    -- 即使执行器只识别其中一个目录，也可以稳定启动。
    if not writeLoaderToAllPaths(loader) then
        return false
    end

    if not autoExecuteEnabled then
        return true
    end

    local queueFunction = getQueueOnTeleport()

    if queueFunction then
        pcall(function()
            queueFunction(loader)
        end)
    end

    return true
end

installAutoExecute()
