local chantingCreatedByScript = nil
local statNodesCreatedByScript = {}

local function setChantingEnabled(enabled)
    chantingEnabled = enabled == true
    local statNodes = getStatNodesFolder()
    if not statNodes then return false, "未找到 statNodes" end

    if chantingEnabled then
        local existing = statNodes:FindFirstChild("Chanting")
        if existing then
            if not existing:IsA("NumberValue") then
                chantingEnabled = false
                return false, "Chanting 不是 NumberValue"
            end
            existing.Value = 1
        else
            existing = Instance.new("NumberValue")
            existing.Name = "Chanting"
            existing.Value = 1
            existing.Parent = statNodes
            chantingCreatedByScript = existing
        end
    elseif chantingCreatedByScript and chantingCreatedByScript.Parent then
        chantingCreatedByScript:Destroy()
        chantingCreatedByScript = nil
    end

    return true
end

local function setStatNodeBundleEnabled(enabled)
    statNodeBundleEnabled = enabled == true
    local statNodes = getStatNodesFolder()
    if not statNodes then return false, "未找到 statNodes" end

    if statNodeBundleEnabled then
        for _, nodeData in ipairs(STAT_NODE_BUNDLE) do
            if not statNodes:FindFirstChild(nodeData.name) then
                local node = Instance.new("NumberValue")
                node.Name = nodeData.name
                node.Value = nodeData.value
                node.Parent = statNodes
                statNodesCreatedByScript[nodeData.name] = node
            end
        end
    else
        for name, node in pairs(statNodesCreatedByScript) do
            if node and node.Parent then node:Destroy() end
            statNodesCreatedByScript[name] = nil
        end
    end

    return true
end

