function saveFavoritesToFile()
    if not writefile then
        warn("[SkillMenu] 当前执行器不支持 writefile，无法保存收藏")
        return
    end

    local arr = {}
    for name, v in pairs(favoriteSkills) do
        if v == true then
            table.insert(arr, name)
        end
    end

    local okEncode, json = pcall(function()
        return HttpService:JSONEncode(arr)
    end)
    if not okEncode then
        warn("[SkillMenu] 收藏编码失败")
        return
    end

    local okWrite, err = pcall(function()
        writefile(SAVE_FILE, json)
    end)
    if not okWrite then
        warn("[SkillMenu] 收藏写入失败:", err)
    else
        warn("[SkillMenu] 收藏已保存到:", SAVE_FILE, "数量:", #arr)
    end
end

function loadFavoritesFromFile()
    if not (readfile and isfile) then
        warn("[SkillMenu] 当前执行器不支持 readfile/isfile，无法读取收藏")
        return
    end

    local targetFile = nil
if isfile(SAVE_FILE) then
    targetFile = SAVE_FILE
elseif isfile(OLD_SAVE_FILE) then
    targetFile = OLD_SAVE_FILE
elseif isfile(LEGACY_SAVE_FILE) then
    targetFile = LEGACY_SAVE_FILE
elseif isfile(LEGACY_OLD_SAVE_FILE) then
    targetFile = LEGACY_OLD_SAVE_FILE
end

    if not targetFile then
        warn("[SkillMenu] 未找到收藏文件:", SAVE_FILE, "或", OLD_SAVE_FILE)
        return
    end

    local okRead, content = pcall(function()
        return readfile(targetFile)
    end)
    if not okRead or type(content) ~= "string" or content == "" then
        warn("[SkillMenu] 收藏读取失败:", targetFile)
        return
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not okDecode or type(data) ~= "table" then
        warn("[SkillMenu] 收藏解析失败:", targetFile)
        return
    end

    table.clear(favoriteSkills)
    for _, name in ipairs(data) do
        if type(name) == "string" then
            favoriteSkills[name] = true
        end
    end

    warn("[SkillMenu] 收藏已加载，数量:", #data, "文件:", targetFile)

    -- 如果读的是旧PlaceId文件，顺手迁移到新GameId文件
    if (targetFile == OLD_SAVE_FILE or targetFile == LEGACY_SAVE_FILE or targetFile == LEGACY_OLD_SAVE_FILE) and writefile then
        pcall(function()
            writefile(SAVE_FILE, HttpService:JSONEncode(data))
        end)
        warn("[SkillMenu] 已迁移收藏到:", SAVE_FILE)
    end
end

