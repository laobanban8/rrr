local function handleSkillClick(skillData)
    if isCtrlHeld() then
        if selectedSkills[skillData.name] then
            removeSelection(skillData.name)
        else
            addSelection(skillData.name)
        end
        refreshEquipPreview()
        updateAllRowVisuals()
        return
    end

    local selectedCount = countSelection()
    local clickedIsSelected = selectedSkills[skillData.name] == true

    if selectedCount > 0 then
        if clickedIsSelected then
            fireSelectedSkills()
        else
            fireSkill(skillData)
        end
        updateAllRowVisuals()
        return
    end

    fireSkill(skillData)
    updateAllRowVisuals()
end

