function setButtonVisual(skillData)
    local row = rowMap[skillData.name]
    if not row then return end

    local isSelected = selectedSkills[skillData.name] == true
    local bgColor = isSelected and COLOR_SELECTED or COLOR_BTN_BG

    row.TagButton.BackgroundColor3 = bgColor
    row.NameButton.BackgroundColor3 = bgColor

    -- Tag 颜色：如果技能在我们检查时发现原生已存在任一目标属性，则显示绿色（原生），否则显示脚本修改蓝色
    local tagColor = COLOR_SCRIPT_MODIFIED
    if skillData.tagColorNative then
        tagColor = COLOR_TAG_GREEN
    end
    row.TagButton.TextColor3 = tagColor

    row.NameButton.TextColor3 = skillData.markAsKickable and COLOR_KICKABLE or COLOR_WHITE

    if skillData.markAsKickable then
        row.KickableLabel.BackgroundColor3 = COLOR_KICKABLE_TAG_BG
        row.KickableLabel.TextColor3 = COLOR_KICKABLE_TAG_TEXT
    end

    if favoriteSkills[skillData.name] then
        row.StarButton.Text = "★"
        row.StarButton.TextColor3 = COLOR_FAVORITE
    else
        row.StarButton.Text = "☆"
        row.StarButton.TextColor3 = COLOR_WHITE
    end
end

function updateSingleRowText(skillData)
    local row = rowMap[skillData.name]
    if not row then return end

    row.TagButton.Text = buildTagOnlyText(skillData)
    local keyPreview = equipPreviewMap[skillData.name]
if keyPreview then
    row.NameButton.Text = "[" .. keyPreview .. "] " .. buildNameOnlyText(skillData)
else
    row.NameButton.Text = buildNameOnlyText(skillData)
end

    if skillData.markAsKickable then
        row.KickableLabel.Visible = true
        row.KickableLabel.Text = "[Kickable]"
    else
        row.KickableLabel.Visible = false
        row.KickableLabel.Text = ""
    end
end

function updateAllRowVisuals()
    for _, skillData in ipairs(scannedSkills) do
        if rowMap[skillData.name] then
            updateSingleRowText(skillData)
            setButtonVisual(skillData)
