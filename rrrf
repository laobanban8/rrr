-- BULK EDIT
--------------------------------------------------
function setupBulkEdit(ui)
    if not ui then
        warn("[BulkEdit] UI 引用不存在")
        return
    end

    if not ui.ApplyButton or not ui.PropDropdown or not ui.ValueInput then
        warn("[BulkEdit] 缺少 ApplyButton / PropDropdown / ValueInput")
        return
    end

    --------------------------------------------------
    -- 属性配置
    -- className 只用于属性不存在时创建新对象
    -- 已存在的属性永远保留原 ClassName
    --------------------------------------------------
    local propertySchema = {
        Cost = {
            className = "NumberValue"
        },
        Cooldown = {
            className = "NumberValue"
        },
        LevelReq = {
            className = "NumberValue"
        },
        BypassStun = {
            className = "BoolValue"
        },

        -- 游戏中这两个属性通常是字符串 "true" / "false"
        CanBlackFlash = {
            className = "StringValue"
        },
        CanChant = {
            className = "StringValue"
        },

        Category = {
            className = "StringValue"
        },
        Description = {
            className = "StringValue"
        },
        Icon = {
            className = "StringValue"
        },
        Innate = {
            className = "StringValue"
        },

        -- 与当前 applyAutoBulkEdit 的创建方式保持一致
        IsModifier = {
            className = "StringValue"
        },

        Type = {
            className = "StringValue"
        },
        Unobtainable = {
            className = "BoolValue"
        }
    }

    --------------------------------------------------
    -- 属性名映射，输入时忽略大小写、空格和下划线
    --------------------------------------------------
    local propertyNameMap = {}

    function propertyKey(text)
        return string.lower(
            tostring(text or "")
                :gsub("%s+", "")
                :gsub("_", "")
        )
    end

    for canonicalName in pairs(propertySchema) do
        propertyNameMap[propertyKey(canonicalName)] = canonicalName
    end

    function resolvePropertyName(text)
        return propertyNameMap[propertyKey(text)]
    end

    --------------------------------------------------
    -- 查找属性，忽略大小写、空格和下划线
    --------------------------------------------------
    function findPropertyObject(skillFolder, propertyName)
        local exactObject = skillFolder:FindFirstChild(propertyName)
        if exactObject then
            return exactObject
        end

        local targetKey = propertyKey(propertyName)

        for _, child in ipairs(skillFolder:GetChildren()) do
            if propertyKey(child.Name) == targetKey then
                return child
            end
        end

        return nil
    end

    --------------------------------------------------
    -- 解析布尔值
    --------------------------------------------------
    function parseBoolean(text)
        local normalized = string.lower(
            tostring(text or "")
                :gsub("^%s+", "")
                :gsub("%s+$", "")
        )

        if normalized == "true"
            or normalized == "1"
            or normalized == "yes"
            or normalized == "on"
            or normalized == "开"
        then
            return true, true
        end

        if normalized == "false"
            or normalized == "0"
            or normalized == "no"
            or normalized == "off"
            or normalized == "关"
        then
            return true, false
        end

        return false, nil
    end

    --------------------------------------------------
    -- 根据对象真实 ClassName 解析新值
    --------------------------------------------------
    function parseValueForObject(valueObject, rawText)
        if valueObject:IsA("StringValue") then
            -- StringValue 永远写入字符串，不转为 BoolValue
            return true, tostring(rawText)
        end

        if valueObject:IsA("BoolValue") then
            local ok, booleanValue = parseBoolean(rawText)

            if not ok then
                return false, nil, "BoolValue 只能输入 true 或 false"
            end

            return true, booleanValue
        end

        if valueObject:IsA("NumberValue")
            or valueObject:IsA("IntValue")
        then
            local numberValue = tonumber(rawText)

            if numberValue == nil then
                return false, nil, "数字属性必须输入有效数字"
            end

            if valueObject:IsA("IntValue") then
                numberValue = math.floor(numberValue)
            end

            return true, numberValue
        end

        return false, nil, "不支持修改 " .. valueObject.ClassName
    end

    --------------------------------------------------
    -- 修改一个技能的属性
    --------------------------------------------------
    function setSkillProperty(
        skillFolder,
        propertyName,
        rawText
    )
        local targetObject = findPropertyObject(
            skillFolder,
            propertyName
        )

        local wasCreated = false

        -- 属性不存在时才创建
        if not targetObject then
            local schema = propertySchema[propertyName]

            if not schema then
                return false, "没有属性配置"
            end

            targetObject = Instance.new(schema.className)
            targetObject.Name = propertyName
            targetObject.Parent = skillFolder
            wasCreated = true
        end

        -- 不操作 Folder、Configuration 等非 ValueBase 对象
        if not targetObject:IsA("ValueBase") then
            if wasCreated then
                targetObject:Destroy()
            end

            return false, (
                propertyName
                .. " 已存在，但不是 ValueBase，而是 "
                .. targetObject.ClassName
            )
        end

        local originalClassName = targetObject.ClassName

        local parseOk, parsedValue, parseError =
            parseValueForObject(targetObject, rawText)

        if not parseOk then
            -- 新创建但输入值无效时清理，避免留下错误对象
            if wasCreated and targetObject.Parent then
                targetObject:Destroy()
            end

            return false, parseError
        end

        local writeOk, writeError = pcall(function()
            targetObject.Value = parsedValue
        end)

        if not writeOk then
            if wasCreated and targetObject.Parent then
                targetObject:Destroy()
            end

            return false, tostring(writeError)
        end

        -- 防御检查：修改值不应改变对象类型
        if targetObject.ClassName ~= originalClassName then
            return false, string.format(
                "ClassName 异常变化：%s -> %s",
                originalClassName,
                targetObject.ClassName
            )
        end

        return true, originalClassName
    end

    --------------------------------------------------
    -- 更新扫描缓存，避免界面仍显示旧值
    --------------------------------------------------
    function updateSkillDataCache(
        propertyName,
        rawText
    )
        for _, skillData in ipairs(scannedSkills) do
            local targetObject = skillData.folder
                and findPropertyObject(
                    skillData.folder,
                    propertyName
                )

            if targetObject and targetObject:IsA("ValueBase") then
                local value = targetObject.Value

                if propertyName == "Cooldown" then
                    skillData.baseCooldown =
                        tonumber(value) or 0

                elseif propertyName == "BypassStun" then
                    skillData.bypassStun =
                        toBoolean(value)

                elseif propertyName == "CanBlackFlash" then
                    skillData.canBlackFlash =
                        toBoolean(value)

                elseif propertyName == "CanChant" then
                    skillData.canChant =
                        toBoolean(value)

                elseif propertyName == "Unobtainable" then
                    skillData.unobtainable =
                        toBoolean(value)
                end
            end
        end
    end

    --------------------------------------------------
    -- 按钮反馈
    --------------------------------------------------
    function showButtonResult(
        text,
        color,
        originalText
    )
        if not ui.ApplyButton or not ui.ApplyButton.Parent then
            return
        end

        ui.ApplyButton.Text = text
        ui.ApplyButton.BackgroundColor3 = color

        task.delay(1, function()
            if ui.ApplyButton and ui.ApplyButton.Parent then
                ui.ApplyButton.Text = originalText
                ui.ApplyButton.BackgroundColor3 = COLOR_GREEN
                ui.ApplyButton.Active = true
            end
        end)
    end

    --------------------------------------------------
    -- 点击批量应用
    --------------------------------------------------
    ui.ApplyButton.MouseButton1Click:Connect(function()
        if not ui.ApplyButton.Active then
            return
        end

        local originalButtonText = ui.ApplyButton.Text
        local propertyName = resolvePropertyName(
            ui.PropDropdown.Text
        )
        local rawValue = tostring(
            ui.ValueInput.Text or ""
        )

        if not propertyName then
            ui.ApplyButton.Active = false

            warn(
                "[BulkEdit] 无效属性名:",
                tostring(ui.PropDropdown.Text)
            )

            showButtonResult(
                "属性名无效",
                COLOR_RED,
                originalButtonText
            )
            return
        end

        if rawValue == "" then
            ui.ApplyButton.Active = false

            showButtonResult(
                "请填写新值",
                COLOR_RED,
                originalButtonText
            )
            return
        end

        local skillsFolder =
            ReplicatedStorage:FindFirstChild("Skills")

        if not skillsFolder then
            ui.ApplyButton.Active = false

            warn(
                "[BulkEdit] 未找到 ReplicatedStorage.Skills"
            )

            showButtonResult(
                "Skills不存在",
                COLOR_RED,
                originalButtonText
            )
            return
        end

        ui.ApplyButton.Active = false
        ui.ApplyButton.Text = "修改中..."
        ui.ApplyButton.BackgroundColor3 =
            COLOR_MEDIUM_GRAY

        task.spawn(function()
            local changedCount = 0
            local failedCount = 0
            local classCount = {}

            for _, skillFolder in ipairs(
                skillsFolder:GetChildren()
            ) do
                if skillFolder:IsA("Folder") then
                    local callOk, setOk, result =
                        pcall(function()
                            return setSkillProperty(
                                skillFolder,
                                propertyName,
                                rawValue
                            )
                        end)

                    if callOk and setOk then
                        changedCount += 1
                        classCount[result] =
                            (classCount[result] or 0) + 1
                    else
                        failedCount += 1

                        warn(
                            "[BulkEdit] 修改失败:",
                            skillFolder.Name,
                            propertyName,
                            callOk and result or setOk
                        )
                    end
                end
            end

            updateSkillDataCache(
                propertyName,
                rawValue
            )

            if uiRefs and uiRefs.RebuildList then
                uiRefs.RebuildList()
            else
                rebuildSkillList(ui)
            end

            local classParts = {}

            for className, count in pairs(classCount) do
                table.insert(
                    classParts,
                    className .. "=" .. tostring(count)
                )
            end

            table.sort(classParts)

            print(string.format(
                "[BulkEdit] 属性=%s，值=%s，成功=%d，失败=%d，保留类型：%s",
                propertyName,
                rawValue,
                changedCount,
                failedCount,
                table.concat(classParts, ", ")
            ))

            if failedCount > 0 then
                showButtonResult(
                    string.format(
                        "%d成功/%d失败",
                        changedCount,
                        failedCount
                    ),
                    Color3.fromRGB(220, 140, 0),
                    originalButtonText
                )
            else
                showButtonResult(
                    "已修改(" .. tostring(changedCount) .. ")",
                    COLOR_SUCCESS,
                    originalButtonText
                )
            end
        end)
    end)
end

