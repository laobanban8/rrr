-- （即把原来的 learnAllBtn.MouseButton1Click:Connect(function() ... end) 替换为此段）
learnAllBtn.MouseButton1Click:Connect(function()
    if not learnAllBtn.Active then return end
    learnAllBtn.Active = false

    local oldText = learnAllBtn.Text
    learnAllBtn.Text = "进行中..."
    learnAllBtn.BackgroundColor3 = COLOR_MEDIUM_GRAY

    task.spawn(function()
        local lp = Players.LocalPlayer
        local rd = lp and lp:FindFirstChild("ReplicatedData")
        local learnedFolder = rd and rd:FindFirstChild("learned")
        local learnedCount = 0
        local skippedCount = 0
        local attemptedCount = 0

        -- 安全地确保 scannedSkills 是最新的列表
        for _, skillData in ipairs(scannedSkills) do
            local name = skillData and skillData.name
            if type(name) == "string" and name ~= "" then
                attemptedCount = attemptedCount + 1

                -- 如果带有 kickable 标签，则自动跳过（不学习）
                if skillData.markAsKickable then
                    skippedCount = skippedCount + 1
                else
                    -- 检查是否已经学过（存在 BoolValue 且值为 true）
                    local already = false
                    if learnedFolder then
                        local flag = learnedFolder:FindFirstChild(name)
                        if flag and flag:IsA("BoolValue") and flag.Value == true then
                            already = true
                        end
                    end

                    if already then
                        skippedCount = skippedCount + 1
                    else
                        -- 调用现有的学习函数（会在 ReplicatedData 中创建 BoolValue）
                        local ok = pcall(function()
                            return learnSkillToReplicatedData(name)
                        end)
                        if ok then
                            learnedCount = learnedCount + 1
                        end
                        -- 小间隔避免短时间内大量创建对象或触发卡顿
                        task.wait(0.02)
                    end
                end
            end
        end

        -- 更新按钮显示，提示结果
        task.delay(0.12, function()
            if not learnAllBtn or not learnAllBtn.Parent then return end
            learnAllBtn.Text = string.format("已学 %d / 跳过 %d", learnedCount, skippedCount)
            learnAllBtn.BackgroundColor3 = (learnedCount > 0) and COLOR_SUCCESS or COLOR_BTN_BG
        end)

        -- 0.9s 后恢复按钮文本与颜色
        task.delay(0.9, function()
            if not learnAllBtn or not learnAllBtn.Parent then return end
            learnAllBtn.Text = oldText
            learnAllBtn.BackgroundColor3 = COLOR_BTN_BG
            learnAllBtn.Active = true
        end)
    end)
end)

