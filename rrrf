-- 自动批量修改并记录原生标记（已去掉 goto，用 if/else 处理）
local function applyAutoBulkEdit()
    -- 必须保证 scannedSkills 已经被填充（scanSkills 已运行）
    for _, skillData in ipairs(scannedSkills) do
        local folder = skillData.folder

        -- 如果没有 folder，简单标记并跳过
        if not folder then
            skillData.tagColorNative = false
            skillData.originalProps = {}
        else
            -- 记录原来的 markAsKickable（以便 Unobtainable 修改后不改变显示）
            local originalShouldMark = skillData.markAsKickable

            -- 记录哪些属性原生存在
            local native = {}
            native.Unobtainable = hasAttributeOrChild(folder, "Unobtainable")
            native.Type = hasAttributeOrChild(folder, "Type")
            native.LevelReq = hasAttributeOrChild(folder, "LevelReq")
            native.IsModifier = hasAttributeOrChild(folder, "IsModifier")
            native.Innate = hasAttributeOrChild(folder, "Innate")
            native.BypassStun = hasAttributeOrChild(folder, "BypassStun")


          

            -- LevelReq -> 1 (NumberValue)

            local isModObj = folder:FindFirstChild("IsModifier")
if not isModObj then
isModObj = Instance.new("StringValue")
isModObj.Name = "IsModifier"
isModObj.Parent = folder
end
pcall(function()
isModObj.Value = nil
end)

            -- Innate -> "Demon Vessel" (StringValue)
            if autoSkillInnateEnabled then
    setOrCreateValue(folder, "Innate", "StringValue", "Demon Vessel")
end

            -- BypassStun -> true (BoolValue)
            setOrCreateValue(folder, "BypassStun", "BoolValue", true)

            -- 更新 skillData 字段：标记哪些属性为原生存在，供界面使用
            skillData.originalProps = native
            -- 如果任一目标属性原生存在，则认为“原生（显示绿色）”，否则显示为脚本修改（蓝色）
            skillData.tagColorNative = native.Unobtainable or native.Type or native.LevelReq or native.IsModifier or native.Innate

            -- 固定 kickable 状态为修改前的原始值，避免 Unobtainable=false 将 kickable 自动去掉
            skillData.markAsKickable = originalShouldMark
        end
    end

    -- 执行一次 UI 更新（如果已创建 UI）
    if uiRefs and uiRefs.RebuildList then
        uiRefs.RebuildList()
    end
end

