function readJsonFileOrDefault(path, defaultValue)
    if not (readfile and isfile) then return defaultValue end
    if not isfile(path) then return defaultValue end

    local okRead, content = pcall(function() return readfile(path) end)
    if not okRead or type(content) ~= "string" or content == "" then
        return defaultValue
    end

    local okDecode, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDecode or type(data) ~= "table" then
        return defaultValue
    end

    return data
end

function writeJsonFile(path, data)
