    -- 批量修改所有技能的 Type StringValue
    --------------------------------------------------
    local skillTypeChangeBusy = false

    local function setAllSkillsType(typeValue)
        if skillTypeChangeBusy then
            return false, 0, 0
        end

        if type(typeValue) ~= "string" or typeValue == "" then
            return false, 0, 0
        end

        local skillsFolder = ReplicatedStorage:FindFirstChild("Skills")
        if not skillsFolder then
            warn("[SkillType] 未找到 ReplicatedStorage.Skills")
            return false, 0, 0
        end

        skillTypeChangeBusy = true

        local changedCount = 0
        local failedCount = 0

        for _, skillFolder in ipairs(skillsFolder:GetChildren()) do
            -- 与当前 scanSkills 的规则保持一致，只处理技能 Folder
            if skillFolder:IsA("Folder") then
                local success, err = pcall(function()
                    local typeObject = skillFolder:FindFirstChild("Type")

                    -- 如果存在同名对象但不是 StringValue，则替换
                    if typeObject and not typeObject:IsA("StringValue") then
                        typeObject:Destroy()
                        typeObject = nil
                    end

                    -- 如果不存在 Type，则创建 StringValue
                    if not typeObject then
                        typeObject = Instance.new("StringValue")
                        typeObject.Name = "Type"
                        typeObject.Parent = skillFolder
                    end

                    typeObject.Value = typeValue
                end)

                if success then
                    changedCount += 1
                else
                    failedCount += 1
                    warn(
                        "[SkillType] 修改失败:",
                        skillFolder:GetFullName(),
                        err
                    )
                end
            end
        end

        skillTypeChangeBusy = false

        print(string.format(
            "[SkillType] 已将 %d 个技能的 Type 修改为 %s，失败 %d 个",
            changedCount,
            typeValue,
            failedCount
        ))

        return true, changedCount, failedCount
    end

    --------------------------------------------------
    -- 按钮反馈函数
    --------------------------------------------------
    local function runSkillTypeChange(button, targetType, normalText, normalColor)
        if skillTypeChangeBusy or not button.Active then
            return
        end

        button.Active = false
        button.Text = "修改中..."
        button.BackgroundColor3 = COLOR_MEDIUM_GRAY

        task.spawn(function()
            local success, changedCount, failedCount = setAllSkillsType(targetType)

            if not button or not button.Parent then
                return
            end

            if success then
                if failedCount > 0 then
                    button.Text = string.format("%d成功/%d失败", changedCount, failedCount)
                    button.BackgroundColor3 = Color3.fromRGB(220, 140, 0)
                else
                    button.Text = "完成(" .. tostring(changedCount) .. ")"
                    button.BackgroundColor3 = COLOR_SUCCESS
                end
            else
                button.Text = "修改失败"
                button.BackgroundColor3 = COLOR_RED
            end

            task.delay(1, function()
                if button and button.Parent then
                    button.Text = normalText
                    button.BackgroundColor3 = normalColor
                    button.Active = true
                end
            end)
        end)
    end

