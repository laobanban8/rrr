UserInputService.InputChanged:Connect(function(input)
    if not settingsDragging
        or input ~= settingsDragInput
        or not settingsDragStart
        or not settingsStartPosition
    then
        return
    end

    local delta = input.Position - settingsDragStart

    local newPosition = UDim2.new(
        settingsStartPosition.X.Scale,
        settingsStartPosition.X.Offset + delta.X,
        settingsStartPosition.Y.Scale,
        settingsStartPosition.Y.Offset + delta.Y
    )

    --------------------------------------------------
    -- 限制设置窗口不能完全拖出屏幕
    --------------------------------------------------
    local camera = workspace.CurrentCamera
    local viewportSize = camera
        and camera.ViewportSize
        or Vector2.new(1920, 1080)

    local frameSize = settingsFrame.AbsoluteSize

    -- 先写入位置，再在下一帧根据实际坐标纠正
    settingsFrame.Position = newPosition

    task.defer(function()
        if not settingsFrame or not settingsFrame.Parent then
            return
        end

        local absolutePosition = settingsFrame.AbsolutePosition
        local correctedX = math.clamp(
            absolutePosition.X,
            0,
            math.max(0, viewportSize.X - frameSize.X)
        )
        local correctedY = math.clamp(
            absolutePosition.Y,
            0,
            math.max(0, viewportSize.Y - frameSize.Y)
        )

        local offsetX = correctedX - absolutePosition.X
        local offsetY = correctedY - absolutePosition.Y

        if offsetX ~= 0 or offsetY ~= 0 then
            settingsFrame.Position = UDim2.new(
                settingsFrame.Position.X.Scale,
                settingsFrame.Position.X.Offset + offsetX,
                settingsFrame.Position.Y.Scale,
                settingsFrame.Position.Y.Offset + offsetY
            )
        end
    end)
