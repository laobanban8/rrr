local function fireAutoTaggedSelectedSkills()
    if not isShiftLockEnabled() then
        return
    end

    local fired = false
    for name in pairs(selectedSkills) do
        local skillData = skillMap[name]
        if skillData then
            local ok = false
            if autoOptions.BlackFlash and skillData.canBlackFlash then
                ok = true
            end
            if autoOptions.Chant and skillData.canChant then
