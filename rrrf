function quantizeStatusValue(rawValue)
    local numberValue = tonumber(rawValue)
    if numberValue == nil then
        return nil
    end

    -- Status 数值精确到 0.05
    return math.round(numberValue / 0.05) * 0.05
end

function formatStatusValue(value)
    if math.floor(value) == value then
        return tostring(value)
    end

    return string.format("%.2f", value)
end

function addStatusToCharacter(statusName, rawValue)
    if type(statusName) ~= "string" or statusName == "" then
        return false, "状态名无效"
    end

    local statuses = getCharacterStatusesFolder()
    if not statuses then
        return false, "未找到 Statuses"
    end

    local statusValue = quantizeStatusValue(rawValue)
    if statusValue == nil then
        return false, "数值无效"
    end

    local statusObject = statuses:FindFirstChild(statusName)

    if statusObject and not statusObject:IsA("NumberValue") then
        return false, statusName .. " 已存在且不是 NumberValue"
    end

    if not statusObject then
        statusObject = Instance.new("NumberValue")
        statusObject.Name = statusName
        statusObject.Value = statusValue
        statusObject.Parent = statuses
    else
        statusObject.Value = statusValue
    end

    return true, statusValue
end

function getFilteredStatuses()
    local result = {}
    local keyword = string.lower(
        tostring(currentStatusSearchText or "")
    )

    for _, statusData in ipairs(scannedStatuses) do
        if type(statusData) == "table"
            and type(statusData.name) == "string"
        then
            local searchableName

            if statusData.name == "" then
                searchableName = "[空位符]"
            else
                searchableName =
                    string.lower(statusData.name)
            end

            if keyword == ""
                or string.find(
                    string.lower(searchableName),
                    keyword,
                    1,
                    true
                )
            then
                table.insert(result, statusData)
            end
        end
    end

    return result
end



function parseWeaponNamesFromSource(src)
    local set = {}

    for name in tostring(src):gmatch('v2%["(.-)"%]%s*=') do
        if name ~= "" then
            set[name] = true
        end
    end

    for name in tostring(src):gmatch("v2%.([%w_]+)%s*=") do
        if name ~= "" then
            set[name] = true
        end
    end

    local arr = {}
    for name in pairs(set) do
        table.insert(arr, name)
    end
    table.sort(arr, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    return arr
end

local manualWeaponTools = {}

function giveWeaponToBackpack(weaponName)
    if type(weaponName) ~= "string" or weaponName == "" then
        return false
    end

    local lp = Players.LocalPlayer
    if not lp then
        return false
    end

    local backpack = lp:FindFirstChild("Backpack")
        or lp:WaitForChild("Backpack", 3)

    if not backpack then
        return false
    end

    local tool = Instance.new("Tool")
    tool.Name = weaponName
    tool.RequiresHandle = false
    tool.CanBeDropped = true
    tool.Parent = backpack

    -- 第一个返回值继续兼容现有自动添加逻辑；
    -- 第二个返回值供手动切换逻辑记录 Tool。
    return true, tool
end

function toggleManualWeapon(weaponName)
    if type(weaponName) ~= "string" or weaponName == "" then
        return false, "invalid_name"
    end

    --------------------------------------------------
    -- 已由左键添加且仍然存在：再次点击时删除
    --------------------------------------------------
    local existingTool = manualWeaponTools[weaponName]

    if existingTool and existingTool.Parent then
        existingTool:Destroy()
        manualWeaponTools[weaponName] = nil
        return true, "removed"
    end

    manualWeaponTools[weaponName] = nil

    --------------------------------------------------
    -- 恢复可能因 UI 重建而丢失的引用
    --------------------------------------------------
    local lp = Players.LocalPlayer
    if not lp then
        return false, "missing_player"
    end

    local containers = {
        lp:FindFirstChild("Backpack"),
        lp.Character
    }

    local objects = workspace:FindFirstChild("Objects")
    local characters = objects
        and objects:FindFirstChild("Characters")
    local customCharacter = characters
        and characters:FindFirstChild(lp.Name)

    if customCharacter then
        table.insert(containers, customCharacter)
    end

    for _, container in ipairs(containers) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Tool")
                    and child:GetAttribute("JJI_ManualWeapon") == true
                    and child:GetAttribute("JJI_ManualWeaponName") == weaponName
                then
                    child:Destroy()
                    return true, "removed"
                end
            end
        end
    end

    --------------------------------------------------
    -- 不存在：添加到背包并标记为手动添加
    --------------------------------------------------
    local added, tool = giveWeaponToBackpack(weaponName)

    if not added or not tool then
        return false, "add_failed"
    end

    tool:SetAttribute("JJI_ManualWeapon", true)
    tool:SetAttribute("JJI_ManualWeaponName", weaponName)
    manualWeaponTools[weaponName] = tool

    return true, "added"
end

function giveItemToInventory(itemName)
