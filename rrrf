local function handleInventoryAddAll()
    if not inventoryAddAllBtn.Active then
        return
    end

    inventoryAddAllBtn.Active = false
    inventoryAddAllBtn.Text = "正在添加..."
    inventoryAddAllBtn.BackgroundColor3 =
        COLOR_MEDIUM_GRAY

    task.spawn(function()
        local addedCount = 0
        local failedCount = 0

        for _, itemData in ipairs(scannedInventoryItems) do
            local itemName =
                type(itemData) == "table"
                and itemData.name
                or nil

            if type(itemName) == "string"
                and itemName ~= ""
            then
                local ok =
                    giveItemToInventory(itemName)

                if ok then
                    addedCount += 1
                else
                    failedCount += 1
                end
            else
                failedCount += 1
                warn(
                    "[Inventory] 跳过无效 Item:",
                    itemData
                )
            end

            task.wait(0.02)
        end

        --------------------------------------------------
        -- 批量添加结束后只刷新一次
        --------------------------------------------------
        local refreshOk, refreshError =
            fireInventoryTableChanged()

        if not refreshOk then
            warn(
                "[Inventory] 批量刷新 TableChanged 失败:",
                refreshError
            )
        end

        task.delay(0.05, function()
            if inventoryAddAllBtn
                and inventoryAddAllBtn.Parent
            then
                inventoryAddAllBtn.Text =
                    string.format(
                        "完成 %d / 失败 %d",
                        addedCount,
                        failedCount
                    )

                inventoryAddAllBtn.BackgroundColor3 =
                    addedCount > 0
                    and COLOR_SUCCESS
                    or COLOR_RED
            end
        end)

        task.delay(0.8, function()
            if inventoryAddAllBtn
                and inventoryAddAllBtn.Parent
            then
                inventoryAddAllBtn.Text =
                    "添加全部物品"

                inventoryAddAllBtn.BackgroundColor3 =
                    COLOR_BTN_BG

                inventoryAddAllBtn.Active = true
            end
        end)
    end)
end

