-- 快速判断某个武器是否启用了自动添加
local autoAddWeapons = {} -- [weaponName] = true

-- 严格保存武器的自动添加顺序
-- 例如：{"Heian Demon", "Copy Katana"}
local autoAddWeaponOrder = {}

-- 自动添加开始前的延迟
local AUTO_ADD_WEAPON_DELAY = 1

--------------------------------------------------
-- 检查顺序表中是否已存在指定武器
--------------------------------------------------
function findAutoAddWeaponOrderIndex(weaponName)
    for index, savedName in ipairs(autoAddWeaponOrder) do
        if savedName == weaponName then
            return index
        end
    end

    return nil
end

--------------------------------------------------
-- 清理自动添加顺序
-- 1. 删除重复项
-- 2. 删除已经关闭的项目
-- 3. 删除无效名称
--------------------------------------------------
function normalizeAutoAddWeaponOrder()
    local normalizedOrder = {}
    local seen = {}

    for _, weaponName in ipairs(autoAddWeaponOrder) do
        if type(weaponName) == "string"
            and weaponName ~= ""
            and autoAddWeapons[weaponName] == true
            and not seen[weaponName]
        then
            seen[weaponName] = true
            table.insert(normalizedOrder, weaponName)
        end
    end

    -- 防止 map 中存在已启用但顺序表遗漏的武器
    -- 这种情况主要用于兼容旧存档
    for _, weaponName in ipairs(WEAPON_NAMES) do
        if autoAddWeapons[weaponName] == true
            and not seen[weaponName]
        then
            seen[weaponName] = true
            table.insert(normalizedOrder, weaponName)
        end
    end

    -- 兼容不在 WEAPON_NAMES 中的自定义武器
    local extraNames = {}

    for weaponName, enabled in pairs(autoAddWeapons) do
        if enabled == true
            and type(weaponName) == "string"
            and weaponName ~= ""
            and not seen[weaponName]
        then
            table.insert(extraNames, weaponName)
        end
    end

    -- 只有旧存档无法确定历史顺序时，额外项目才按名称排序
    table.sort(extraNames, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    for _, weaponName in ipairs(extraNames) do
        seen[weaponName] = true
        table.insert(normalizedOrder, weaponName)
    end

    table.clear(autoAddWeaponOrder)

    for _, weaponName in ipairs(normalizedOrder) do
        table.insert(autoAddWeaponOrder, weaponName)
    end
end

--------------------------------------------------
-- 开启指定武器的自动添加
-- 新开启的武器永远放在顺序末尾
--------------------------------------------------
function enableAutoAddWeapon(weaponName)
    if type(weaponName) ~= "string" or weaponName == "" then
        return false
    end

    if autoAddWeapons[weaponName] == true then
        -- 已开启时不改变原来的顺序
        if not findAutoAddWeaponOrderIndex(weaponName) then
            table.insert(autoAddWeaponOrder, weaponName)
        end

        return false
    end

    autoAddWeapons[weaponName] = true
    table.insert(autoAddWeaponOrder, weaponName)

    return true
end

--------------------------------------------------
-- 关闭指定武器的自动添加
-- 同时从顺序表中删除
--------------------------------------------------
function disableAutoAddWeapon(weaponName)
    if type(weaponName) ~= "string" or weaponName == "" then
        return false
    end

    autoAddWeapons[weaponName] = nil

    for index = #autoAddWeaponOrder, 1, -1 do
        if autoAddWeaponOrder[index] == weaponName then
            table.remove(autoAddWeaponOrder, index)
        end
    end

    return true
end

--------------------------------------------------
-- 切换自动添加状态
--------------------------------------------------
function toggleAutoAddWeapon(weaponName)
    if autoAddWeapons[weaponName] == true then
        disableAutoAddWeapon(weaponName)
        return false
    end

    enableAutoAddWeapon(weaponName)
    return true
end

