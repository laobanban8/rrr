fireSkill = function(skillData)
    if not remoteEvent or not skillData then
        return
    end

    local now = tick()
    local baseCooldown = tonumber(skillData.baseCooldown) or 0

    -- 只有当前不在冷却中时，才开始新的冷却计时
    if baseCooldown > 0 then
        if not skillData.cooldownEnd or skillData.cooldownEnd <= now then
            skillData.cooldownEnd = now + baseCooldown
        end
    end

    updateSingleRowText(skillData)

    local row = rowMap[skillData.name]
    if row then
        refreshSkillRatingLabels(skillData, row)
    end

    task.spawn(function()
        pcall(function()
            remoteEvent:FireServer(skillData.name)
        end)
    end)
end

function loadLoadoutByName(loadoutName)
    local name = trimText(loadoutName)
    if name == "" then name = "Default" end

    local data = readLoadoutsData()
    if type(data.presets) ~= "table" then
        return false, 0, name
    end

    local preset = data.presets[name]
    if type(preset) ~= "table" then
        return false, 0, name
    end

    local mapping = preset.mapping
    if type(mapping) ~= "table" then
        return false, 0, name
    end

    -- 恢复键位顺序
    if uiRefs and uiRefs.KeyOrderBox and type(preset.keyOrder) == "string" then
        uiRefs.KeyOrderBox.Text = preset.keyOrder
    end

    local innates = getInnatesFolder()
    if not innates then
        warn("[Loadout] 未找到 ReplicatedData.techniques.innates")
        return false, 0, name
    end

    local count = 0
    for keyName, skillName in pairs(mapping) do
        if type(keyName) == "string" and type(skillName) == "string" then
            local keyObj = findChildLoose(innates, keyName)
            if keyObj and keyObj:IsA("StringValue") then
                keyObj.Value = skillName
                count += 1
            end
        end
    end

    -- 记录最后使用的方案
    data.lastUsed = name
    writeJsonFile(LOADOUTS_FILE, data)

    if uiRefs and uiRefs.RefreshInnateSlotLabel then
        uiRefs.RefreshInnateSlotLabel()
    end
    refreshEquipPreview()
    updateAllRowVisuals()

    return true, count, name
end

