function removeSelection(name)
    if selectedSkills[name] then
        selectedSkills[name] = nil
        for i = #selectedOrder, 1, -1 do
            if selectedOrder[i] == name then
                table.remove(selectedOrder, i)
                break
            end
        end
    end
end

