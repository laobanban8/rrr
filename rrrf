local function cooldownToRating(rawCooldown)
    local cooldown = math.max(0, tonumber(rawCooldown) or 0)
    local thresholds = {
        {1, "SSS+"}, {1.5, "SSS"}, {2, "SSS-"},
        {3, "SS+"}, {5, "SS"}, {7, "SS-"},
        {10, "S+"}, {13, "S"}, {15, "S-"},
        {18, "A+"}, {20, "A"}, {25, "A-"},
        {30, "B+"}, {35, "B"}, {40, "B-"},
        {50, "C+"}, {60, "C"}, {70, "C-"},
        {80, "D+"}, {90, "D"}, {100, "D-"},
        {125, "F+"}, {150, "F"}
    }

    -- 边界取较好评级，所以 1 秒为 SSS+、150 秒为 F。
    for _, threshold in ipairs(thresholds) do
        if cooldown <= threshold[1] then
            return threshold[2]
        end
    end

    return "F-"
end

local function compactRatingVariant(value)
    local text = tostring(value or "Unknown")
        :gsub("（", "(")
        :gsub("）", ")")

    local normal, variant = text:match("^%s*([^%(%)]+)%s*%(([^%(%)]+)%)%s*$")
    if not normal then
        return text
    end

    normal = normal:gsub("^%s+", ""):gsub("%s+$", "")
    variant = variant:gsub("^%s+", ""):gsub("%s+$", "")

    if string.lower(normal) == string.lower(variant) then
        return normal
    end

    return normal .. "(" .. variant .. ")"
end

local function getSkillRatingValues(skillData)
    if skillData.markAsKickable then
        return {
            "Unknown", "Unknown", "Unknown", "Unknown",
            "Unknown", "Unknown", "Unknown"
        }
    end

    local source = SKILL_RATINGS[skillData.name] or {
        "Unknown", "Unknown", "Unknown",
        "Unknown", "Unknown", "Unknown"
    }

    local values = {
        source[1], source[2], source[3], source[4],
        cooldownToRating(skillData.baseCooldown),
        source[5], source[6]
    }

    for index, value in ipairs(values) do
        values[index] = compactRatingVariant(value)
    end

    return values
end

local function colorToHex(color)
    return string.format(
        "#%02X%02X%02X",
        math.round(color.R * 255),
        math.round(color.G * 255),
        math.round(color.B * 255)
    )
end

local function escapeRichText(text)
    return tostring(text or "")
        :gsub("&", "&amp;")
        :gsub("<", "&lt;")
        :gsub(">", "&gt;")
end

local function colorizeRatingText(value)
    value = escapeRichText(value)

    return value:gsub("([A-Za-z]+[%+%-]*)", function(token)
        local color = RATING_COLORS[token]

        -- SSS+ 不再使用动态 HSV。
        -- 它会交给 applySpecialRatingGradient 使用静态彩虹渐变。
        if token == "SSS+" then
            return token
        end

        if not color then
            return token
        end

        return '<font color="' .. colorToHex(color) .. '">'
            .. token
            .. '</font>'
    end)
end

