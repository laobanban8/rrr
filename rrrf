local INVENTORY_ITEM_NAMES = {}

local function parseInventoryItemSource(source)
    local result = {}
    local seen = {}

    for rawName in (tostring(source) .. "\n"):gmatch("(.-)\n") do
        local itemName = rawName
            :gsub("\r", "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")

        if itemName ~= "" and not seen[itemName] then
            seen[itemName] = true
            table.insert(result, itemName)
        end
    end

    return result
end

