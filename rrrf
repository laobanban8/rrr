function startAutoCastSelected(intervalText)
    if autoCastSelectedRunning then
        return false, "running"
    end

    local picked = getOrderedSelectedSkills()
    if #picked == 0 then
        return false, "empty"
    end

    autoCastSelectedInterval = math.clamp(tonumber(intervalText) or 0, 0.05, 5)
    autoCastSelectedRunning = true

    autoCastSelectedThread = task.spawn(function()
        while autoCastSelectedRunning do
            local currentPicked = getOrderedSelectedSkills()

            if #currentPicked == 0 then
                autoCastSelectedRunning = false
                break
            end

            for i, skillName in ipairs(currentPicked) do
                if not autoCastSelectedRunning then
                    break
                end

                local skillData = skillMap[skillName]
                if skillData then
                    fireSkill(skillData)
                end

                if not autoCastSelectedRunning then
                    break
                end

                if i < #currentPicked then
                    task.wait(autoCastSelectedInterval)
                end
            end

            if autoCastSelectedRunning then
                task.wait(autoCastSelectedInterval)
            end
        end
    end)

    return true, "ok"
end

