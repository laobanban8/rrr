    for token in string.gmatch(src, "[^,%s]+") do
        local k = string.upper(token)
        if valid[k] then
            table.insert(keys, k)
            valid[k] = nil -- 去重
        end
    end

    if #keys == 0 then
        for _, k in ipairs(getInnateKeysFromFolder()) do
