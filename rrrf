function learnSkillToReplicatedData(skillName)
    if type(skillName) ~= "string" or skillName == "" then
        return false
    end

    local lp = Players.LocalPlayer
    if not lp then
        return false
    end

    local replicatedData = lp:FindFirstChild("ReplicatedData")
    if not replicatedData then
        return false
    end

    local learned = replicatedData:FindFirstChild("learned")
    if not learned then
        learned = Instance.new("Folder")
        learned.Name = "learned"
        learned.Parent = replicatedData
    end

    local flag = learned:FindFirstChild(skillName)
    if flag and not flag:IsA("BoolValue") then
        flag:Destroy()
        flag = nil
    end

    if not flag then
        flag = Instance.new("BoolValue")
        flag.Name = skillName
        flag.Parent = learned
    end

    flag.Value = true
    return true
end

function toBoolean(v)
    if typeof(v) == "boolean" then
        return v
    elseif typeof(v) == "number" then
        return v ~= 0
    elseif typeof(v) == "string" then
        local s = string.lower(v)
        return s == "true" or s == "1" or s == "yes"
    end
    return false
end

function getChildValue(folder, childName)
    local obj = folder:FindFirstChild(childName)
    if obj and obj:IsA("ValueBase") then
        return obj.Value
    end
    return nil
end

function getStringTrue(folder, childName)
    local obj = folder:FindFirstChild(childName)
    if obj and obj:IsA("StringValue") then
        return string.lower(tostring(obj.Value)) == "true"
    end
    return false
end

function getBoolTrue(folder, childName)
    local obj = folder:FindFirstChild(childName)
    if obj and obj:IsA("BoolValue") then
        return obj.Value == true
    end
    return false
end

function inWhitelist(name)
    for _, v in ipairs(WHITELIST_SKILLS) do
        if v == name then
            return true
        end
    end
    return false
end

function normalizeKey(str)
    return string.lower((str or ""):gsub("%s+", ""))
end

function findChildLoose(parent, targetName)
    local target = normalizeKey(targetName)

    -- 先精确找
    local exact = parent:FindFirstChild(targetName)
    if exact then
        return exact
    end

    -- 再模糊找（忽略大小写、空格）
    for _, child in ipairs(parent:GetChildren()) do
        if normalizeKey(child.Name) == target then
            return child
        end
    end

    return nil
end

function parseAnyValue(raw)
    local t = typeof(raw)

    if t == "boolean" then
        return raw
    elseif t == "number" then
        return raw
    elseif t == "string" then
        local s = string.lower(raw)
        if s == "true" then
            return true
        elseif s == "false" then
            return false
        end

        local num = tonumber(raw)
        if num ~= nil then
            return num
        end

        return raw
    end

    return raw
end

function getValue(folder, childName)
    -- 1. 先读 Attribute
    local attr = folder:GetAttribute(childName)
    if attr ~= nil then
        return parseAnyValue(attr)
    end

    -- 2. 再读忽略大小写的 Attribute
    for attrName, attrValue in pairs(folder:GetAttributes()) do
        if normalizeKey(attrName) == normalizeKey(childName) then
            return parseAnyValue(attrValue)
        end
    end

    -- 3. 再读子对象
    local obj = findChildLoose(folder, childName)
    if obj and obj:IsA("ValueBase") then
        return parseAnyValue(obj.Value)
    end

    return nil
end

function roundNumber(n)
    if typeof(n) ~= "number" then
        return 0
    end
    if math.floor(n) == n then
        return tostring(n)
    end
    return string.format("%.1f", n)
end

function getRemainingCooldown(skillData)
    if not skillData.cooldownEnd then
        return 0
    end
    return math.max(0, skillData.cooldownEnd - tick())
end

function getCooldownTag(skillData)
    local base = tonumber(skillData.baseCooldown) or 0
    if base <= 0 then
        return nil
    end

    local remain = getRemainingCooldown(skillData)
    if remain > 0 then
        return "[cooldown:" .. tostring(math.ceil(remain)) .. "]"
    else
        return "[cooldown:" .. roundNumber(base) .. "]"
    end
end

function buildTagOnlyText(skillData)
    local tags = {}

    local cdTag = getCooldownTag(skillData)
    if cdTag then
        table.insert(tags, cdTag)
    end
    if skillData.canBlackFlash then
        table.insert(tags, "[canblackflash]")
    end
    if skillData.canChant then
        table.insert(tags, "[canchant]")
    end
    if skillData.bypassStun then
        table.insert(tags, "[bypassstun]")
    end

    return table.concat(tags, " ")
end

function buildNameOnlyText(skillData)
    return skillData.name
end

