local function setupUIHideHotkey(ui)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        if hideHotkeyCaptureBox then
            local box = hideHotkeyCaptureBox
            local keyCode = input.KeyCode

            if keyCode ~= Enum.KeyCode.Unknown then
                hideHotkeyName = keyCode.Name
                box.Text = hideHotkeyName
                hideHotkeyCaptureBox = nil
                box:ReleaseFocus()
                refreshToggleSettings()
            end
            return
        end

        if gameProcessed or not hideHotkeyEnabled then
            return
        end

        if UserInputService:GetFocusedTextBox() then
            return
        end

        local configuredKey = Enum.KeyCode[hideHotkeyName]
        if configuredKey and input.KeyCode == configuredKey then
            mainUIHidden = not mainUIHidden
            ui.ScreenGui.Enabled = not mainUIHidden

            local sequenceGui = player.PlayerGui:FindFirstChild(
                "SkillSequenceEditorUI"
            )
            if sequenceGui then
                sequenceGui.Enabled = not mainUIHidden
            end
        end
    end)
end

