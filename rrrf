function quantizeStatusValue(rawValue)
    local numberValue = tonumber(rawValue)
    if numberValue == nil then
        return nil
    end

    -- Status 数值精确到 0.05
    return math.round(numberValue / 0.05) * 0.05
end

function formatStatusValue(value)
    if math.floor(value) == value then
        return tostring(value)
    end

    return string.format("%.2f", value)
end

function toggleCharacterStatus(statusName, rawValue)
    if type(statusName) ~= "string" then
        return false,
            "invalid_name",
            "状态名必须是字符串"
    end

    local statuses = getCharacterStatusesFolder()

    if not statuses then
        return false,
            "missing_folder",
            "未找到 Statuses"
    end

    --------------------------------------------------
    -- 已存在：删除所有同名 NumberValue
    --------------------------------------------------
    local matchingStatuses = {}

    for _, child in ipairs(statuses:GetChildren()) do
        if child.Name == statusName then
            if child:IsA("NumberValue") then
                table.insert(matchingStatuses, child)
            else
                local shownName =
                    statusName == ""
                    and "[空位符]"
                    or statusName

                return false,
                    "wrong_type",
                    shownName
                    .. " 已存在且不是 NumberValue"
            end
        end
    end

    if #matchingStatuses > 0 then
        for _, statusObject in ipairs(matchingStatuses) do
            statusObject:Destroy()
        end

        return true,
            "removed",
            #matchingStatuses
    end

    --------------------------------------------------
    -- 不存在：创建 NumberValue
    --------------------------------------------------
    local statusValue = quantizeStatusValue(rawValue)

    if statusValue == nil then
        return false,
            "invalid_value",
            "数值无效"
    end

    local createOk, statusObjectOrError = pcall(function()
        local statusObject = Instance.new("NumberValue")

        -- 允许空字符串 Name
        statusObject.Name = statusName
        statusObject.Value = statusValue
        statusObject.Parent = statuses

        return statusObject
    end)

    if not createOk then
        return false,
            "create_failed",
            tostring(statusObjectOrError)
    end

    return true,
        "added",
        statusValue
end

