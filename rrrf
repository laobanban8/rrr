local scannedStatuses = {}
local statusRowMap = {}
local currentStatusSearchText = ""

local emptyPlaceholderInserted = false
local previousWasPerceptionBlock = false

for rawLine in (
    tostring(STATUS_SOURCE):gsub("\r\n", "\n")
    .. "\n"
):gmatch("(.-)\n") do
    local statusName = rawLine:gsub("\r", "")

    if statusName == "" then
        -- 只保留 PerceptionBlock 与 Lucky1 中间的真实空位符。
        -- 不把字符串开头/结尾产生的空行误当成额外 Status。
        if previousWasPerceptionBlock
            and not emptyPlaceholderInserted
        then
            table.insert(scannedStatuses, {
                name = "",
                isEmptyPlaceholder = true
            })

            emptyPlaceholderInserted = true
        end
    else
        statusName = statusName
            :gsub("^%s+", "")
            :gsub("%s+$", "")

        if statusName ~= "" then
            table.insert(scannedStatuses, {
                name = statusName,
                isEmptyPlaceholder = false
            })

            previousWasPerceptionBlock =
                statusName == "PerceptionBlock"
        end
    end
end

table.sort(scannedStatuses, function(a, b)
    if type(a) ~= "table" then
        return false
    end

    if type(b) ~= "table" then
        return true
    end

    local aName = type(a.name) == "string"
        and a.name
        or ""

    local bName = type(b.name) == "string"
        and b.name
        or ""

    -- 真实空位符固定放在列表最前面。
    if a.isEmptyPlaceholder == true
        and b.isEmptyPlaceholder ~= true
    then
        return true
    end

    if a.isEmptyPlaceholder ~= true
        and b.isEmptyPlaceholder == true
    then
        return false
    end

    return string.lower(aName)
        < string.lower(bName)
