    end

    local charactersFolder =
        objectsFolder:FindFirstChild("Characters")

    if not charactersFolder then
        return nil
    end

    return charactersFolder:FindFirstChild(player.Name)
end

function findEquippedCopyKatana()
    local character =
        getWorkspacePlayerCharacter()

    if not character then
        return nil, nil
    end

    -- 只检查角色当前直接持有的 Tool
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool")
            and child.Name == "Copy Katana"
        then
            return child, character
        end
    end

    return nil, character
end

function fastReequipCopyKatana()

if not copyKatanaReequipEnabled then
    return false
end

    if copyKatanaReequipBusy then
        return false
    end

    local copyKatana, character = findEquippedCopyKatana()

    -- 按下 G 时必须正在手持 Copy Katana
    if not copyKatana or not character then
        return false
    end

    copyKatanaReequipBusy = true

    task.spawn(function()
        local ok, err = pcall(function()
            --------------------------------------------------
            -- 按下 G 后延迟 0.5 秒再卸下
            --------------------------------------------------
            task.wait(0.5)

            -- 延迟期间可能已经切换武器，因此重新检测
            local currentCopyKatana, currentCharacter =
                findEquippedCopyKatana()

            if not currentCopyKatana or not currentCharacter then
                return
            end

            local backpack =
                player:FindFirstChild("Backpack")
                or player:WaitForChild("Backpack", 1)

            if not backpack then
                return
            end

            --------------------------------------------------
            -- 卸下 Copy Katana
            --------------------------------------------------
            currentCopyKatana.Parent = backpack

            --------------------------------------------------
            -- 立即重新装备，不额外等待 0.5 秒
            --------------------------------------------------
            currentCopyKatana.Parent = currentCharacter
        end)

        if not ok then
            warn(
                "[HiddenCopyKatana] G键重新装备失败:",
                err
            )
        end

        copyKatanaReequipBusy = false
    end)

    return true
end

function setupHiddenCopyKatanaReequip()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end

        -- 玩家正在输入 TextBox 时不触发
        if UserInputService:GetFocusedTextBox() then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        if input.KeyCode ~= Enum.KeyCode.G then
            return
        end

        fastReequipCopyKatana()
    end)
end

