function clampInterval(v)
    v = tonumber(v) or 0
    return math.clamp(v, 0, 100)
end

function sequenceToEditorText()
    local lines = {}
    for i, step in ipairs(sequenceConfig.steps) do
        lines[i] = string.format("%s | %.2f", tostring(step.skill or ""), clampInterval(step.wait or sequenceConfig.defaultInterval))
    end
    return table.concat(lines, "\n")
end

function parseEditorTextToSteps(text)
    local steps = {}
    for line in tostring(text or ""):gmatch("[^\r\n]+") do
        line = trimText(line)
        if line ~= "" then
            local skill, waitText = line:match("^(.-)%s*[|｜]%s*([%d%.]+)%s*$")
            if not skill then
                skill = line
                waitText = nil
            end
            skill = trimText(skill)
            if skill ~= "" then
                table.insert(steps, {
                    skill = skill,
                    wait = clampInterval(waitText or sequenceConfig.defaultInterval)
                })
            end
        end
    end
    return steps
end

function loadSequenceFromFile()
    local data = readJsonFileOrDefault(SEQUENCE_FILE, nil)
    local loadedFromLegacy = false

    if type(data) ~= "table" and readfile and isfile and isfile(LEGACY_SEQUENCE_FILE) then
        data = readJsonFileOrDefault(LEGACY_SEQUENCE_FILE, nil)
        loadedFromLegacy = type(data) == "table"
    end

    if type(data) ~= "table" then
        sequenceConfig.steps = {}
        return
    end

    local steps = {}
    local defaultInterval = clampInterval(data.defaultInterval or 0)

    -- 新格式
    if type(data.steps) == "table" then
        for _, step in ipairs(data.steps) do
            if type(step) == "table" and type(step.skill) == "string" and step.skill ~= "" then
                table.insert(steps, {
                    skill = step.skill,
                    wait = clampInterval(step.wait or defaultInterval)
                })
            end
        end
    end

    -- 兼容旧格式 order + interval
    if #steps == 0 and type(data.order) == "table" then
        local oldI = clampInterval(data.interval or defaultInterval)
        for _, name in ipairs(data.order) do
            if type(name) == "string" and name ~= "" then
                table.insert(steps, { skill = name, wait = oldI })
            end
        end
    end

    sequenceConfig.steps = steps
    sequenceConfig.defaultInterval = defaultInterval

    if loadedFromLegacy then
        writeJsonFile(SEQUENCE_FILE, {
            steps = sequenceConfig.steps,
            defaultInterval = sequenceConfig.defaultInterval,
            savedAt = os.time()
        })
    end
end

