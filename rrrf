local function applyTextStroke(label, color, transparency)
    local stroke = label:FindFirstChild("RatingTextStroke")
    if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Name = "RatingTextStroke"
        stroke.Thickness = 1.15
        stroke.LineJoinMode = Enum.LineJoinMode.Round
        stroke.Parent = label
    end

    stroke.Color = color or Color3.fromRGB(0, 0, 0)
    stroke.Transparency = transparency or 0.25
end

local function applyRatingTitleStyle(titleLabel, index)
    local oldGradient = titleLabel:FindFirstChild("RatingTitleGradient")
    if oldGradient then
        oldGradient:Destroy()
    end

    titleLabel.Font = Enum.Font.GothamBlack
    titleLabel.TextSize = 15
    titleLabel.TextScaled = false
    titleLabel.TextWrapped = false
    titleLabel.TextTruncate = Enum.TextTruncate.None
    titleLabel.TextStrokeTransparency = 1
    titleLabel.TextColor3 = RATING_TITLE_COLORS[index] or COLOR_WHITE

    applyTextStroke(
        titleLabel,
        RATING_TITLE_STROKE_COLORS[index] or Color3.fromRGB(0, 0, 0),
        0.18
    )

    -- 隐蔽性：斜向静态黑白分色，黑白各占 50%。
    if index == 3 then
        titleLabel.TextColor3 = COLOR_WHITE

        local gradient = Instance.new("UIGradient")
        gradient.Name = "RatingTitleGradient"
        gradient.Rotation = 45
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.000, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.499, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.501, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 255, 255))
        })
        gradient.Parent = titleLabel
    end
end

local function removeRatingGradient(valueLabel)
    local oldGradient = valueLabel:FindFirstChild("SpecialRatingGradient")
    if oldGradient then
        oldGradient:Destroy()
    end
end

local function applySpecialRatingGradient(valueLabel, rawValue)
    removeRatingGradient(valueLabel)

    local value = tostring(rawValue or "Unknown")
    local gradient = nil

    if string.find(value, "Infinite", 1, true) then
        gradient = Instance.new("UIGradient")
        gradient.Name = "SpecialRatingGradient"
        gradient.Rotation = 45

        -- Infinite：蓝 -> 黑；中央黑色严格占 10%；黑 -> 白。
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(35, 145, 255)),
            ColorSequenceKeypoint.new(0.45, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 255, 255))
        })

    elseif string.find(value, "Changing", 1, true) then
        gradient = Instance.new("UIGradient")
        gradient.Name = "SpecialRatingGradient"
        gradient.Rotation = 0

        -- Changing：左侧 50% 纯黑，右侧 50% 纯白。
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.499, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.501, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 255, 255))
        })

    elseif string.find(value, "SSS+", 1, true) then
        gradient = Instance.new("UIGradient")
        gradient.Name = "SpecialRatingGradient"
        gradient.Rotation = 0

        -- SSS+：静态彩虹渐变，不再随 tick 变化。
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 60, 60)),    -- 红
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 150, 45)),   -- 橙
            ColorSequenceKeypoint.new(0.32, Color3.fromRGB(255, 235, 70)),   -- 黄
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(80, 255, 120)),   -- 绿
            ColorSequenceKeypoint.new(0.68, Color3.fromRGB(70, 180, 255)),   -- 蓝
            ColorSequenceKeypoint.new(0.84, Color3.fromRGB(150, 90, 255)),   -- 紫
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 85, 220))    -- 粉
        })
    end

    if gradient then
        -- UIGradient 只能稳定作用于普通 TextColor3。
        -- 所以特殊评级必须关闭 RichText。
        valueLabel.TextColor3 = COLOR_WHITE
        gradient.Parent = valueLabel
        return true
    end

    return false
end

local function refreshSkillRatingLabels(skillData, row)
    if not row or not row.RatingLabels then
        return
    end

    local values = getSkillRatingValues(skillData)

    for index, ratingRefs in ipairs(row.RatingLabels) do
        local valueLabel = ratingRefs.ValueLabel
        local value = tostring(values[index] or "Unknown")

        ratingRefs.TitleLabel.Text = RATING_TITLES[index]
        applyRatingTitleStyle(ratingRefs.TitleLabel, index)

        local usesSpecialGradient = applySpecialRatingGradient(
            valueLabel,
            value
        )

        if usesSpecialGradient then
            -- Infinite / Changing / SSS+ 都走静态 UIGradient。
            valueLabel.RichText = false
            valueLabel.Text = value
        else
            valueLabel.RichText = true
            valueLabel.TextColor3 = COLOR_WHITE
            valueLabel.Text = colorizeRatingText(value)
        end
    end
end

function getInnatesFolder()
    local rd = player:FindFirstChild("ReplicatedData")
    if not rd then return nil end
    local techniques = rd:FindFirstChild("techniques")
    if not techniques then return nil end
    local innates = techniques:FindFirstChild("innates")
    if not innates then return nil end
    return innates
end

function getInnateKeysFromFolder()
    local innates = getInnatesFolder()
    local found = {}
    local ordered = {}

    if innates then
        for _, obj in ipairs(innates:GetChildren()) do
            if obj:IsA("StringValue") then
                found[string.upper(obj.Name)] = true
            end
        end
    end

    -- 按默认顺序输出，而不是字母排序
    for _, k in ipairs(DEFAULT_EQUIP_KEYS) do
        if found[k] then
            table.insert(ordered, k)
            found[k] = nil
        end
    end

    -- 如果有额外键位，不在默认表里，再补到后面
    for keyName in pairs(found) do
        table.insert(ordered, keyName)
    end

    if #ordered == 0 then
        for _, k in ipairs(DEFAULT_EQUIP_KEYS) do
            table.insert(ordered, k)
        end
    end

    return ordered
end

