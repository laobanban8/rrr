function getFilteredSortedSkills()
    local result = {}
    local keyword = string.lower(currentSearchText or "")

    for _, skillData in ipairs(scannedSkills) do
        if keyword == "" or string.find(string.lower(skillData.name), keyword, 1, true) then
            table.insert(result, skillData)
        end
    end

    table.sort(result, function(a, b)
        local af = favoriteSkills[a.name] and 1 or 0
        local bf = favoriteSkills[b.name] and 1 or 0

        if af ~= bf then
            return af > bf
        end

        return string.lower(a.name) < string.lower(b.name)
    end)

    return result
end


