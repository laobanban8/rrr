function runSavedSequenceOnce()
    if sequenceBusy then
        return false, "busy", 0
    end
    if #sequenceConfig.steps == 0 then
        return false, "empty", 0
    end

    sequenceBusy = true
    local total = #sequenceConfig.steps

    task.spawn(function()
        for i, step in ipairs(sequenceConfig.steps) do
