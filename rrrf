function scanSkills()
    table.clear(scannedSkills)
    table.clear(skillMap)

    local skillsFolder = ReplicatedStorage:FindFirstChild("Skills")
    if not skillsFolder then
        warn("[SkillMenu] 未找到 ReplicatedStorage.Skills")
        return
    end

    local snapshotChanged = false

for _, skillFolder in ipairs(skillsFolder:GetChildren()) do
    if skillFolder:IsA("Folder") then
        local skillName = skillFolder.Name

        local isWhitelisted =
            inWhitelist(skillName)

        if isWhitelisted then
            forceWhitelistSkillObtainable(skillFolder)
        end

        local currentUnobtainable

        if isWhitelisted then
            currentUnobtainable = false
        else
            currentUnobtainable =
                getValue(skillFolder, "Unobtainable") == true
        end

        local attributeSnapshot =
            skillFolder:GetAttribute("JJI_OriginalUnobtainable")

        local originalUnobtainable =
            currentUnobtainable
            or attributeSnapshot == true
            or originalKickableSkills[skillName] == true

        local forceKickable =
            FORCE_KICKABLE_SKILLS[skillName] == true

        local shouldMark =
            forceKickable
            or (originalUnobtainable and not isWhitelisted)

        if shouldMark
            and originalKickableSkills[skillName] ~= true
        then
            originalKickableSkills[skillName] = true
            snapshotChanged = true
        end

        if attributeSnapshot == nil then
            pcall(function()
                skillFolder:SetAttribute(
                    "JJI_OriginalUnobtainable",
                    originalUnobtainable
                )
            end)
        end

        local skillData = {
            name = skillName,
            folder = skillFolder,
            unobtainable = currentUnobtainable,
            originalUnobtainable = originalUnobtainable,
            markAsKickable = shouldMark,
            baseCooldown = tonumber(
                getChildValue(
                    skillFolder,
                    "Cooldown"
                )
            ) or 0,
            canBlackFlash = getStringTrue(
                skillFolder,
                "CanBlackFlash"
            ),
            canChant = getStringTrue(
                skillFolder,
                "CanChant"
            ),
            bypassStun = getBoolTrue(
                skillFolder,
                "BypassStun"
            ),
            cooldownEnd = 0
        }

        table.insert(scannedSkills, skillData)
        skillMap[skillName] = skillData
    end
end

    if snapshotChanged then
        saveKickableSnapshot()
    end

    print(
        "[SkillMenu] 扫描完成，共发现 "
        .. tostring(#scannedSkills)
        .. " 个技能"
    )
end

-- 辅助：判断 Folder 中是否原生存在某属性（Attribute 或子对象）
local function hasAttributeOrChild(folder, name)
    if folder:GetAttribute(name) ~= nil then
        return true
    end
    if folder:FindFirstChild(name) then
        return true
    end
    -- 忽略大小写匹配（与 findChildLoose 保持一致的查找逻辑）
    for _, child in ipairs(folder:GetChildren()) do
        if normalizeKey(child.Name) == normalizeKey(name) then
            return true
        end
    end
    return false
end

-- 将指定值写回到 folder（创建或修改），并返回是否原本存在与原值（用于记录）
local function setOrCreateValue(folder, name, className, value)
    local origExists = false
    local origValue = nil
    local obj = findChildLoose(folder, name)
    if obj and obj:IsA(className) then
        origExists = true
        if obj:IsA("BoolValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") then
            origValue = obj.Value
        end
    end

    -- 特殊处理：如果目标为 nil（例如 IsModifier 需要删除），则删除原对象并返回
    if value == nil then
        if obj then
            obj:Destroy()
        end
        return origExists, origValue
    end

    if obj and obj:IsA(className) then
        -- 修改
        if obj:IsA("BoolValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") then
            obj.Value = value
        end
    else
        -- 创建新的 Value 对象
        local newObj = Instance.new(className)
        newObj.Name = name
        if newObj:IsA("BoolValue") or newObj:IsA("NumberValue") or newObj:IsA("StringValue") then
            newObj.Value = value
        end
        newObj.Parent = folder
    end

    return origExists, origValue
end

