function getGuiMousePosition()
    local inset = GuiService:GetGuiInset()
    local mouse = UserInputService:GetMouseLocation()
    return Vector2.new(mouse.X - inset.X, mouse.Y - inset.Y)
end

function rectFromPoints(a, b)
    local x1 = math.min(a.X, b.X)
    local y1 = math.min(a.Y, b.Y)
    local x2 = math.max(a.X, b.X)
    local y2 = math.max(a.Y, b.Y)
    return x1, y1, x2, y2
end

function intersects(r1x1, r1y1, r1x2, r1y2, r2x1, r2y1, r2x2, r2y2)
    return not (r2x1 > r1x2 or r2x2 < r1x1 or r2y1 > r1y2 or r2y2 < r1y1)
end

function updateSelectionBoxVisual(ui)
    if not boxSelecting or not boxStartPos or not boxCurrentPos then
        ui.SelectionBox.Visible = false
        return
    end

    local x1, y1, x2, y2 = rectFromPoints(boxStartPos, boxCurrentPos)
    ui.SelectionBox.Visible = true
    ui.SelectionBox.Position = UDim2.fromOffset(x1, y1)
    ui.SelectionBox.Size = UDim2.fromOffset(x2 - x1, y2 - y1)
end

function updateBoxSelection(ui)
    if not boxSelecting or not boxStartPos or not boxCurrentPos then
        return
    end

    local x1, y1, x2, y2 = rectFromPoints(boxStartPos, boxCurrentPos)

    for name, row in pairs(rowMap) do
        local absPos = row.RowFrame.AbsolutePosition
        local absSize = row.RowFrame.AbsoluteSize
        local rx1 = absPos.X
        local ry1 = absPos.Y
        local rx2 = absPos.X + absSize.X
        local ry2 = absPos.Y + absSize.Y

        if intersects(x1, y1, x2, y2, rx1, ry1, rx2, ry2) then
            addSelection(name)
        end
    end
    refreshEquipPreview()
    updateAllRowVisuals()
end

function handleAutoScrollDuringBox(ui)
    if not boxSelecting then return end

    local mouse = getGuiMousePosition()
    local sf = ui.ScrollFrame
    local absPos = sf.AbsolutePosition
    local absSize = sf.AbsoluteSize

    if mouse.X >= absPos.X and mouse.X <= absPos.X + absSize.X then
        local edgeThreshold = 24

        if mouse.Y >= absPos.Y + absSize.Y - edgeThreshold then
            sf.CanvasPosition = Vector2.new(
                sf.CanvasPosition.X,
                math.min(sf.CanvasSize.Y.Offset, sf.CanvasPosition.Y + 14)
            )
        elseif mouse.Y <= absPos.Y + edgeThreshold then
            sf.CanvasPosition = Vector2.new(
                sf.CanvasPosition.X,
                math.max(0, sf.CanvasPosition.Y - 14)
            )
        end
    end
end

function setupBoxSelect(ui)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end

        if input.UserInputType == Enum.UserInputType.MouseButton2 and isCtrlHeld() then
            boxSelecting = true
            boxStartPos = getGuiMousePosition()
            boxCurrentPos = boxStartPos
            updateSelectionBoxVisual(ui)
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            if hasAnySelection() then
                fireAutoTaggedSelectedSkills()
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input, gpe)
        if gpe then return end

        if boxSelecting and input.UserInputType == Enum.UserInputType.MouseMovement then
            boxCurrentPos = getGuiMousePosition()
            handleAutoScrollDuringBox(ui)
            updateSelectionBoxVisual(ui)
            updateBoxSelection(ui)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 and boxSelecting then
            boxSelecting = false
            ui.SelectionBox.Visible = false
        end
    end)
end

