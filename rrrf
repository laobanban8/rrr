        for _, weaponName in ipairs(data) do
            if type(weaponName) == "string"
                and weaponName ~= ""
                and autoAddWeapons[weaponName] ~= true
            then
                autoAddWeapons[weaponName] = true
                table.insert(
                    autoAddWeaponOrder,
                    weaponName
                )
            end
        end
    else
        --------------------------------------------------
        -- 兼容旧 map 格式：
        -- {
        --     ["Heian Demon"] = true,
        --     ["Copy Katana"] = true
        -- }
        --
        -- 旧 map 本身没有可靠的历史顺序，因此首次迁移时
        -- 按 WEAPON_NAMES 中的固定列表顺序恢复。
        --------------------------------------------------
        for weaponName, enabled in pairs(data) do
            if type(weaponName) == "string"
                and weaponName ~= ""
                and enabled == true
            then
                autoAddWeapons[weaponName] = true
            end
        end
    end

    normalizeAutoAddWeaponOrder()
end

